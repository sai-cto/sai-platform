# Copy to .env.local (git-ignored). `npm run setup` does this for you and fills in
# local-only values. This file lists NAMES ONLY: never put a value in it.

# --- Local database (filled in by `npm run setup`) ---
POSTGRES_PORT=
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
# The app connects as the restricted role sai_app (row-level security applies).
DATABASE_URL=
# Migrations and seeding connect as the owner role sai_owner.
DATABASE_OWNER_URL=
# Same two, for the automated tests (database sai_test).
TEST_DATABASE_URL=
TEST_DATABASE_OWNER_URL=

# --- App ---
APP_URL=
# "true" enables the pick-a-user login. Local development only; ignored in production.
AUTH_DEV_LOGIN=
# Where uploaded files are written by the local-disk storage adapter.
FILE_STORAGE_DIR=

# --- Customer links ---
# Signs the no-account links customers get by email (estimate review, invoice payment).
# Any long random string; `npm run setup` generates one. Changing it invalidates every link.
LINK_SIGNING_SECRET=

# --- Maps (Hired Hands estimate builder: automatic mileage and drive time) ---
# A Google Maps Platform key with the Distance Matrix API enabled. Leave empty to enter mileage
# by hand (the estimate builder then says so). Never commit a key.
GOOGLE_MAPS_API_KEY=

# --- Movegistics import (scripts/hhmc-import) ---
# The Movegistics Open API key, if the import uses the API. Local only; never commit it.
MOVEGISTICS_API_KEY=

# --- Payments ---
# "mock" (default) or "stripe". The Stripe adapter refuses any key that is not a TEST key.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=

# --- Sign-in providers (leave empty: not configured yet) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your own directory id (a GUID). "common" and "organizations" are refused.
MICROSOFT_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your Google Workspace domain. Only accounts of this Workspace may sign in.
GOOGLE_WORKSPACE_DOMAIN=

# --- Hosted demo site only (docs/DEPLOY-DEMO.md). Leave empty locally. ---
# "true" = demo mode: access password, demo accounts, banner, fake payments, no email, no dev login.
DEMO_MODE=
# The shared password everyone types before seeing anything (at least 12 characters).
DEMO_ACCESS_PASSWORD=
# The demo accounts, separated by ";": email|Full name|gm or staff or tech|password (12+ characters).
DEMO_ACCOUNTS=
# "yes" wipes and re-seeds the demo database on the next deploy. Set it back to "no" afterwards.
DEMO_RESET_ON_DEPLOY=
# Lets the hosting's scheduler call /api/cron/scheduled (at least 16 characters).
CRON_SECRET=
# Database connections per server instance (default 10; 3 is plenty on serverless hosting).
DATABASE_POOL_MAX=

# --- Hosted pilot with REAL data (docs/DEPLOY-DEMO.md). Leave empty locally. ---
# "true" = pilot: Microsoft sign-in only, live data never wiped, no customer email, no live card payments.
PILOT_MODE=
# Who may sign in, separated by ";": email|Full name|cto or tech or gm or staff (no passwords).
PILOT_ACCOUNTS=
