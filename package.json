{
  "name": "sai-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "secret-scan": "bash scripts/secret-scan.sh",
    "setup": "tsx scripts/setup.ts",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:down": "docker compose --env-file .env.local down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "docs:permissions": "tsx scripts/generate-permissions-doc.ts",
    "hhmc:automations": "tsx scripts/hhmc-automations.ts",
    "demo:prepare": "tsx scripts/demo-prepare.ts",
    "demo:seed": "tsx scripts/demo-prepare.ts --reset",
    "demo:build": "tsx scripts/demo-prepare.ts && next build",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts --trace off",
    "check": "npm run typecheck && npm run lint && npm run test && npm run secret-scan",
    "hhmc:import": "tsx scripts/hhmc-import/index.ts",
    "hhmc:import:real": "tsx scripts/hhmc-import/index.ts --real",
    "hhmc:sync-to-pilot": "tsx scripts/hhmc-sync/index.ts"
  },
  "dependencies": {
    "arctic": "3.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "papaparse": "5.7.0",
    "postgres": "4.1.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "stripe": "23.1.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
